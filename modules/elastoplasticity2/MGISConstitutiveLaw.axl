<?xml version="1.0" ?>
<service name="MGISConstitutiveLaw" version="1.0" type="caseoption"
         parent-name="Arcane::ArcaneFem::ConstitutiveLawBase"
         namespace-name="Arcane::ArcaneFem"
         >
  <description>Law using the MGIS library</description>
  <interface name="Arcane::ArcaneFem::IConstitutiveLaw" inherited="false"/>
  <variables>
    <variable field-name="sigma_gp" name="SigmaGp" data-type="real" item-kind="cell" shape-dim="2">
      <description>Stress tensor on gauss points</description>
    </variable>
    <variable field-name="sigma_zz_gp" name="SigmaZZGp" data-type="real" item-kind="cell" shape-dim="1">
      <description>zz component of stress tensor on gauss points</description>
    </variable>
    <variable field-name="C_tang_gp" name="CTangGp" data-type="real" item-kind="cell" shape-dim="3">
      <description>Tangent of the material tensor for constitutive law</description>
    </variable>
    <variable field-name="DUn" name="DUn" data-type="real3" item-kind="node" dim="0">
      <description>Time step DUn vector from Arcane variable</description>
    </variable>
  </variables>
  <options>
    <simple name="library" type="string" default="libVonMises.so">
      <description>Path of the MFront behaviour library.</description>
    </simple>
    <simple name="behaviour" type="string" default="VonMises">
      <description>Name of the behaviour in the MFront library.</description>
    </simple>
    <complex name="material-property"
             type="MaterialProperty"
             minOccurs = "0"
             maxOccurs = "unbounded"
      >
      <description>
        List of materials properties used in mgis::behaviour::setMaterialProperty()
      </description>
      <simple name="name" type="string">
        <description>Name of the property</description>
      </simple>
      <simple name="value" type="real">
        <description>Value of the property</description>
      </simple>
    </complex>
  </options>
</service>
