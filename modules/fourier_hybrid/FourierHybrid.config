<?xml version="1.0" ?>
 <arcane-config code-name="Fourier">
  <time-loops>
    <time-loop name="FourierHybridLoop">
      <title>Fem</title>
      <description>Default timeloop for code Fourier</description>

      <modules>
        <module name="FourierHybrid" need="required" />
        <module name="ArcanePostProcessing" need="required" />
      </modules>

      <entry-points where="init">
        <entry-point name="FourierHybrid.StartInit" />
      </entry-points>
      <entry-points where="compute-loop">
        <entry-point name="FourierHybrid.Compute" />
      </entry-points>
    </time-loop>
  </time-loops>
</arcane-config>
